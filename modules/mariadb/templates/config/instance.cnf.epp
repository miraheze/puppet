<%- | String $title,
      String $datadir,
      String $tmpdir,
      String $socket,
      Integer $port,
      String $error_log,
      Optional[Variant[String, Boolean]] $innodb_buffer_pool_size,
      Optional[Integer] $read_only,
      String $pid_file
| -%>
[mysqld.<%= $title %>]
datadir = <%= $datadir %>
tmpdir = <%= $tmpdir %>
socket = <%= $socket %>
port = <%= $port %>
extra-port = <%= $port + 20 %>
log-error = <%= $error_log %>
<%- if $innodb_buffer_pool_size { -%>
innodb_buffer_pool_size = <%= $innodb_buffer_pool_size %>
<%- } -%>
read-only = <%= $read_only %>
pid-file = <%= $pid_file %>
ssl
ssl-capath                     = /etc/ssl/certs
ssl-cert                       = /etc/ssl/localcerts/wikitide.net.crt
ssl-key                        = /etc/ssl/private/wikitide.net.key

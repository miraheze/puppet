<%- | Integer $quick_abort_min,
      Integer $quick_abort_max,
      Integer $read_ahead_gap,
      Integer $forward_timeout,
      Integer $connect_timeout,
      Integer $peer_connect_timeout,
      Integer $forward_max_tries,
      Integer $dns_timeout,
      Integer $read_timeout,
      Integer $request_timeout,
      Integer $client_lifetime | -%>
# This file is managed by puppet

http_port 8080

acl everything src all
cache deny everything
acl apache rep_header Server ^Apache
maximum_object_size 1010 MB
cache_replacement_policy heap LFUDA

access_log /var/log/squid/access.log squid
coredump_dir /var/spool/squid
cache_store_log none
hosts_file /etc/hosts
refresh_pattern ^ftp:		1440	20%	10080
refresh_pattern ^gopher:	1440	0%	1440
refresh_pattern .		0	20%	4320
quick_abort_min <%= $quick_abort_min %> KB
quick_abort_max <%= $quick_abort_max %> KB
read_ahead_gap <%= $read_ahead_gap %> KB
forward_timeout <%= $forward_timeout %> seconds
connect_timeout <%= $connect_timeout %> seconds
peer_connect_timeout <%= $peer_connect_timeout %> seconds
forward_max_tries <%= $forward_max_tries %>
dns_timeout <%= $dns_timeout %> seconds
read_timeout <%= $read_timeout %> seconds
request_timeout <%= $request_timeout %> seconds
client_lifetime <%= $client_lifetime %> seconds

# ACLs
acl SSL_ports port 22     # ssh
acl SSL_ports port 443    # https
acl SSL_ports port 873    # rsync
acl SSL_ports port 6697   # irc tls
acl Safe_ports port 21    # ftp
acl Safe_ports port 22    # ssh
acl Safe_ports port 80    # http
acl Safe_ports port 443   # https
acl Safe_ports port 873   # rsync
acl Safe_ports port 11371 # keyserver

# Unreg Ports
acl Safe_ports port 1025-65535 # unreg

# methods
acl purge method PURGE
acl CONNECT method CONNECT

# WikiTide
acl wikitide src 2602:294:0:c8::/64
acl wikitide src 2602:294:0:b13::/64
acl wikitide src 2602:294:0:b23::/64
acl wikitide src 2602:294:0:b12::/64
acl wikitide src 2602:294:0:b33::/64
acl wikitide src 2602:294:0:b39::/64
acl wikitide src 2602:294:0:f702::/64
acl wikitide src 2604:2dc0:202:300::3569
acl wikitide src 15.204.95.61
acl wikitide src 10.0.0.0/8

acl stop_hierarchy urlpath_regex cgi-bin \?
always_direct allow stop_hierarchy

# Access
http_access allow manager localhost
http_access deny manager
http_access allow purge localhost
http_access deny purge
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny !CONNECT SSL_ports
http_access deny to_localhost
http_access allow localhost
http_access allow wikitide
http_access deny all
http_reply_access allow all

request_header_access X-Request-Id deny all
request_header_access Traceparent deny all
request_header_access Tracestate deny all
request_header_access Baggage deny all
request_header_access X-Client-Ip deny all

icp_access deny all

via off

netdb_filename none

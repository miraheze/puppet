<%- | Array[Hash] $resources | -%>
<%- $static_configs = $resources.map |$resource| {
  $labels = $resource['parameters']['labels']
  $targets = "${resource['parameters']['hostname']}:${resource['parameters']['port']}"
  { 'targets' => [$targets], 'labels' => $labels }
} -%>
# This file is managed by puppet
<%= stdlib::to_yaml($static_configs) %>

<%- | Pattern[/:\d+$/] $web_listen_address,
      Array[String] $collectors_enabled,
      String $ignored_mount_points,
      String $ignored_fs_types,
      String $ignored_devices,
      String $textfile_directory,
      String $netstat_fields,
      String $vmstat_fields,
      String $collector_ntp_server
| -%>
<%-
  $arguments = flatten([
    "--web.listen-address=${web_listen_address}",
    if 'filesystem' in $collectors_enabled {
      ["--collector.filesystem.ignored-mount-points=${ignored_mount_points}", "--collector.filesystem.ignored-fs-types=${ignored_fs_types}"]
    } else { [] },
    if 'diskstats' in $collectors_enabled {
      ["--collector.diskstats.ignored-devices=${ignored_devices}"]
    } else { [] },
    if 'textfile' in $collectors_enabled {
      ["--collector.textfile.directory=${textfile_directory}"]
    } else { [] },
    if 'netstat' in $collectors_enabled {
      ["--collector.netstat.fields=${netstat_fields}"]
    } else { [] },
    if 'vmstat' in $collectors_enabled {
      ["--collector.vmstat.fields=${vmstat_fields}"]
    } else { [] },
    if 'ntp' in $collectors_enabled {
      ["--collector.ntp.server=${collector_ntp_server}"]
    } else { [] },
    $collectors_enabled.map |$collector| { "--collector.${collector}" },
  ])
-%>
# Generated by Puppet -- do not modify
ARGS='<%= $arguments.sort.join(' ') %>'

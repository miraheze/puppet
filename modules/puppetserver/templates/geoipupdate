#!/bin/bash
set -e

DEST="/root/private/files/geoip"

for edition in GeoLite2-Country GeoLite2-City GeoLite2-ASN; do
    wget "https://download.maxmind.com/app/geoip_download?edition_id=${edition}&license_key=<%= @geoip_key %>&suffix=tar.gz" \
        -O "${edition}.tar.gz"

    tar zxvf "${edition}.tar.gz"

    mv "${edition}"_*/"${edition}.mmdb" "${DEST}/${edition}.mmdb"

    rm -rf "${edition}"_20*
    rm "${edition}.tar.gz"
done

git -C /root/private add files/geoip/
git -C /root/private commit -m "GeoIPUpdate"
git -C /root/private push

<%- | Haproxy::Lbpools $pools,
        Hash[String, Hash] $servers,
        Haproxy::Timeout $timeout,
        Integer[1] $timeout_queue,
        Stdlib::Port $agent_port,
| -%>
<%- $pools.each |$pool_name, $pool| { -%>
<%- $pool_agent = $pool['agent'] ? { false => false, default => true } -%>
<%- $check_uri = pick($pool['check_uri'], '/check') -%>
<%- $check_host = pick($pool['check_host'], 'health.wikitide.net') -%>
<%- $check_status = pick($pool['check_status'], 204) -%>
<%- $check_method = pick($pool['check_method'], 'HEAD') -%>
listen lb_<%= $pool_name %>
    no log
    bind 127.0.0.1:<%= $pool['port'] %>

    option http-keep-alive
    http-reuse always

    timeout http-request <%= $timeout['http_request'] %>s
    timeout http-keep-alive <%= $timeout['keep_alive'] %>s
    timeout client <%= $timeout['client'] %>s
    timeout client-fin <%= $timeout['client_fin'] %>s
    timeout connect <%= $timeout['connect'] %>s
    timeout server <%= $timeout['server'] %>s
    timeout tunnel <%= $timeout['tunnel'] %>s
    timeout queue <%= $timeout_queue %>s
    timeout check 3s

    # Polled by the Varnish probe. Fails once no server is left.
    monitor-uri /__lb_status
    monitor fail if { nbsrv(lb_<%= $pool_name %>) lt 1 }

    balance leastconn
    retries 3
    option redispatch

    option httpchk
    http-check send meth <%= $check_method %> uri <%= $check_uri %> ver HTTP/1.1 hdr Host <%= $check_host %>
    http-check expect status <%= $check_status %>

    default-server ssl verify none tfo alpn h2,http/1.1 check check-ssl check-alpn http/1.1 inter 3s fastinter 1s downinter 3s fall 3 rise 2 slowstart 30s

<%- $servers.keys.sort.each |$name| { -%>
<%- $property = $servers[$name] -%>
<%- if $property['lb_pool'] == $pool_name { -%>
<%- $server_agent = $property['lb_agent'] ? { undef => $pool_agent, default => $property['lb_agent'] } -%>
    server <%= $name %> <%= $name %>.<%= pick($property['domain'], 'fsslc.wtnet') %>:443 weight <%= pick($property['lb_weight'], 100) %><%= $property['lb_maxconn'] ? { undef => '', default => " maxconn ${property['lb_maxconn']}" } %><%= $server_agent ? { true => " agent-check agent-port ${agent_port} agent-inter 2s", default => '' } %>
<%- } -%>
<%- } -%>

<%- } -%>

global
        maxconn 200000

listen lb_jobrunner
        option httpchk
        http-check send meth GET  uri /healthcheck.php
        http-check expect status 204
        mode http
        bind :9007
        bind :::9007
        balance leastconn
        timeout queue <%= @timeout_queue %>
        default-server check inter 3s fastinter 1s downinter 3s fall 3 rise 2 weight 100 agent-check agent-port <%= @agent_port %> agent-inter 2s slowstart 30s
        <%- @backends.each_pair do | name, property | -%>
        server <%= name %> <%= property['ip'] %>:<%= property['port'] %>
        <%- end -%>
        http-request set-header Host jobrunner.svc.fsslc.wtnet

        # Preserve the X-Request-ID header
        http-request set-header X-Request-ID %[req.hdr(X-Request-ID)]


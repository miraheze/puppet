[Unit]
Description=TCP passthrough proxy to smtp-relay.gmail.com:465
After=network.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:465,fork,reuseaddr TCP:smtp-relay.gmail.com:465
Restart=always
RestartSec=2
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target

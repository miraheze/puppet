<%- | Stdlib::Yes_no $use_chroot,
      Optional[Stdlib::Unixpath] $log_file,
      Integer $timeout,
      String $address,
      Hash $rsyncd_conf
| -%>
# This file is being maintained by Puppet.
# DO NOT EDIT

uid = nobody
gid = nogroup
use chroot = <%= $use_chroot %>
<%- if $log_file { %>log file = <%= $log_file %><%- } %>
log format = %t %a %m %f %b
syslog facility = local3
timeout = <%= $timeout %>
address = <%= $address %>
<%- if $rsyncd_conf != {} { -%>
<%= $rsyncd_conf.map |$k, $v| { "${k} = ${v}" }.join("\n") %>
<%- } -%>

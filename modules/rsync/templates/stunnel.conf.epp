<%- | Stdlib::Unixpath $rsync_conf | -%>
# This file is managed by puppet

[rsync]
accept = :::1873
client = no

CAfile = <%= "${puppet_ssldir()}/certs/ca.pem" %>
cert   = <%= "${puppet_ssldir()}/certs/${facts['networking']['fqdn']}.pem" %>
key    = <%= "${puppet_ssldir()}/private_keys/${facts['networking']['fqdn']}.pem" %>

verifyChain = yes

exec = /usr/bin/rsync
execargs = rsync --daemon --config <%= $rsync_conf %>

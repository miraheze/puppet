# ============================================================================
# Grafana
# ============================================================================

def backup_grafana_db(dt: str):

    backup_db = '/var/lib/grafana/grafana_backup.db'

    outputFileName = '/srv/backups/grafana.tar.gz'

    try:
        subprocess.check_call(
            f'/usr/bin/sqlite3 /var/lib/grafana/grafana.db ".backup \'/var/lib/grafana/grafana_backup.db\'"',
            preexec_fn=os.setsid,
        )

        create_tar(
            backup_db,
            outputFileName,
            "grafana_backup.db",
        )

        s3_upload(
            outputFileName,
            f"sql/grafana/{dt}.tar.gz",
        )
    finally:
        if os.path.exists(outputFileName):
            os.remove(outputFileName)

        if os.path.exists(backup_db):
            os.remove(backup_db)


# ============================================================================
# MediaWiki XML
# ============================================================================

def backup_mediawiki_xml(
    dt: str,
    database: str,
):

    def get_php_keys(file_path):

        try:
            command = (
                "/usr/bin/php -r '"
                f'$list = include "{file_path}"; '
                'if (is_array($list["databases"] ?? false)) { '
                'echo implode(PHP_EOL, '
                'array_keys($list["databases"])); '
                '} else { '
                'echo "Invalid format"; '
                "}'"
            )

            output = subprocess.check_output(
                command,
                shell=True,
                text=True,
                preexec_fn=os.setsid,
            )

            return output.strip().splitlines()

        except subprocess.CalledProcessError as e:
            print(
                f"Error executing PHP: {e}"
            )

            return []

    if database is None:
        if os.path.exists(
            '/srv/mediawiki/cache/databases.php'
        ):

            dbs = get_php_keys(
                '/srv/mediawiki/cache/databases.php'
            )
        else:
            with open(
                '/srv/mediawiki/cache/databases.json',
                encoding="utf-8",
            ) as file:

                dbs = (
                    json.load(file)
                    ["combi"]
                    .keys()
                )
    else:
        dbs = [database]

    for db in dbs:
        version = subprocess.check_output(
            [
                '/usr/local/bin/getMWVersion',
                db,
            ],
            text=True,
        ).strip()

        runner = (
            f"/srv/mediawiki/{version}/"
            'maintenance/run.php'
        )

        output = f"/srv/backups/{db}.xml.gz"

        try:
            subprocess.check_call(
                (
                    f"/usr/bin/php {runner} "
                    f"/srv/mediawiki/{version}/"
                    'maintenance/dumpBackup.php '
                    '--logs '
                    '--uploads '
                    '--full '
                    f'--output="gzip:{output}" '
                    f"--wiki {db}"
                ),
                shell=True,
                preexec_fn=os.setsid,
            )

            s3_upload(
                output,
                f"mediawiki-xml/{db}/{dt}.xml.gz"
            )
        except subprocess.CalledProcessError as e:
            print(
                f"WARNING: encountered "
                f"CalledProcessError backing up "
                f"{db}, returned code "
                f"{e.returncode}"
            )
        finally:
            if os.path.exists(output):
                os.remove(output)


# ============================================================================
# Backup dispatcher
# ============================================================================

def backup(
    source: str,
    database: str,
):
    dt = datetime.now().strftime(
        "%Y-%m-%d"
    )

    start = time.time()

    print(
        f"Starting backup of '{source}' "
        f"for date {dt}..."
    )

    if source == 'private':
        backup_private(dt)
    elif source == 'sslkeys':
        backup_sslkeys(dt)
    elif source == 'swift-account-container':
        backup_swift_account_container(dt)
    elif source == 'phorge_db':
        backup_phorge_db(dt)
    elif source == 'phorge_images':
        backup_phorge_images(dt)
    elif source == 'sql':
        backup_sql(
            dt,
            database,
        )
    elif source == 'grafana':
        backup_grafana_db(dt)
    elif source == 'mediawiki-xml':
        backup_mediawiki_xml(
            dt,
            database,
        )
    elif source == 'mattermost-data':
        backup_mattermost_data(dt)
    elif source == 'mattermost-db':
        backup_mattermost_db(dt)
    elif source == 'puppetdb':
        backup_puppetdb(dt)
    else:
        raise ValueError(
            f"Unsupported backup type: {source}"
        )

    print(
        f"Completed! This took "
        f"{time.time() - start:.2f}s"
    )


# ============================================================================
# Backup object name
# ============================================================================

def get_backup_object(
    source: str,
    dt: str,
    database: str,
):

    if source in {
        'private',
        'sslkeys',
        'swift-account-container',
        'mattermost-data',
    }:
        return (
            f"{source}/{dt}.tar.gz"
        )

    if source == 'mediawiki-xml':
        if database is None:
            raise ValueError(
                '--database is required for '
                'mediawiki-xml downloads'
            )

        return (
            f"mediawiki-xml/{database}/{dt}.xml.gz"
        )

    if source == 'grafana':
        return (
            f"sql/grafana/{dt}.tar.gz"
        )

    if source == "sql":
        if database is None:
            raise ValueError(
                '--database is required for '
                'sql downloads'
            )

        return (
            f"sql/{database}/{dt}.sql.gz"
        )

    if source in {
        'mattermost-db',
        'puppetdb',
    }:
        return (
            f"{source}/{dt}.sql.gz"
        )

    if source == 'phorge_db':
        return (
            f"phorge/{dt}_db.sql.gz"
        )

    if source == 'phorge_images':
        return (
            f"phorge/{dt}_images.tar.gz"
        )

    if source == 'test':
        return (
            f"test/{dt}.iso"
        )

    raise ValueError(
        f"Unsupported backup type: {source}"
    )


# ============================================================================
# Download
# ============================================================================

def download(
    source: str,
    dt: str,
    database: str,
):

    start = time.time()

    print(
        f"Downloading backup of '{source}' "
        f"for date {dt}..."
    )

    object_name = get_backup_object(
        source,
        dt,
        database,
    )

    s3_download(
        object_name
    )

    print(
        f"Completed! This took "
        f"{time.time() - start:.2f}s"
    )


# ============================================================================
# Find backups
# ============================================================================

def find_backups(
    source: str,
    database: str,
):

    if source == "sql" and database:
        prefix = (
            f"sql/{database}/"
        )
    elif source == "mediawiki-xml" and database:
        prefix = (
            f"mediawiki-xml/{database}/"
        )
    else:
        prefix = f"{source}/"

    backups = s3_list(
        prefix
    )

    if source == 'sql' and database:
        for backup_item in backups:
            filename = backup_item[
                len(prefix):
            ]

            print(
                filename.removesuffix(
                    '.sql.gz'
                )
            )
    elif source == 'mediawiki-xml' and database:
        for backup_item in backups:
            filename = backup_item[
                len(prefix):
            ]

            print(
                filename.removesuffix(
                    '.xml.gz'
                )
            )
    else:
        for backup_item in backups:
            print(backup_item)


# ============================================================================
# Main
# ============================================================================

if __name__ == "__main__":

    if args.action == 'set-lifecycle':
        set_lifecycle()
    elif args.action == 'list-lifecycle':
        list_lifecycle()
    elif args.action == 'backup':
        if not args.type:
            parser.error(
                'backup requires a backup type'
            )

        backup(
            args.type,
            args.database,
        )
    elif args.action == 'download':
        if not args.type:
            parser.error(
                "download requires a backup type"
            )

        if not args.date:
            parser.error(
                '--date is required when '
                'downloading a file'
            )

        download(
            args.type,
            args.date,
            args.database,
        )
    elif args.action == 'find':
        if not args.type:
            parser.error(
                'find requires a backup type'
            )

        find_backups(
            args.type,
            args.database,
        )

# ============================================================================
# MariaDB
# ============================================================================

def backup_sql(
    dt: str,
    database: str,
):

    if database is None:
        dbs = [
            name
            for name in sorted(
                os.listdir('/srv/mariadb')
            )
            if (
                os.path.isdir(
                    f"/srv/mariadb/{name}"
                )
                and name.endswith('wiki')
            )
        ]
    else:
        dbs = [database]

    os.makedirs(
        '/srv/backups/dbs',
        exist_ok=True,
    )

    for db in dbs:

        print(f"Backing up database '{db}'...")

        outputFileName = f"/srv/backups/dbs/{db}.sql.gz"

        try:
            subprocess.check_call(
                (
                    '/usr/bin/ionice -c2 -n7 '
                    '/usr/bin/mariadb-dump '
                    '--quick '
                    '--skip-lock-tables '
                    '--single-transaction '
                    '-c '
                    f"--ignore-table={db}.objectcache "
                    f"--ignore-table={db}.querycache "
                    f"--ignore-table={db}.querycachetwo "
                    f"--ignore-table={db}.recentchanges "
                    f"--ignore-table={db}.searchindex "
                    f"{db} "
                    '| /usr/bin/nice '
                    '/usr/bin/pigz '
                    '-p '
                    '<%= $compress_threads %> '
                    f"> {outputFileName}"
                ),
                shell=True,
                preexec_fn=os.setsid,
            )

            s3_upload(
                outputFileName,
                f"sql/{db}/{dt}.sql.gz",
            )
        finally:
            if os.path.exists(outputFileName):
                os.remove(outputFileName)



<%- $cpu_third = $facts['processors']['count'] / 3
$compress_threads = if $cpu_third > 1 { $cpu_third } else { 1 }
-%>
#!/usr/bin/python3 -u
#
# Backup script for WikiTide
# Created by John Lewis 2022
#
# Uses OVHcloud Object Storage through the AWS S3 API.
#

import argparse
import json
import os
import subprocess
import tarfile
import time

from datetime import datetime


# ============================================================================
# Configuration
# ============================================================================

S3_BUCKET = 'wikitide-backup'

AWS_CONFIG_FILE = '/etc/wikitide-backup/aws-config'
AWS_CREDENTIALS_FILE = '/etc/wikitide-backup/aws-credentials'
AWS_PROFILE = 'default'

# S3 storage class.
#
# NOTE: aws s3 cp does not accept/use S3_STORAGE_CLASS.
# OVH Object Storage uses STANDARD storage by default, so
# uploads made with aws s3 cp are stored as STANDARD.
#
# This is kept here for documentation/reference if we later
# switch to an S3 API operation that supports an explicit
# storage-class parameter.
S3_STORAGE_CLASS = 'STANDARD'

# HTTP/HTTPS proxy used by the AWS CLI.
S3_PROXY = 'http://bastion.fsslc.wtnet:8080'

# https://docs.ovhcloud.com/en/guides/storage-and-backup/object-storage/s3-bucket-lifecycle
LIFECYCLE_FILE = '/etc/wikitide-backup/lifecycle.json'

# ============================================================================
# Argument parsing
# ============================================================================

parser = argparse.ArgumentParser(
    description=(
        'Provides backup, download, find and lifecycle '
        'management functionality for WikiTide backups '
        'using OVH Object Storage.'
    )
)

parser.add_argument(
    'action',
    choices=[
        'backup',
        'download',
        'find',
        'set-lifecycle',
        'list-lifecycle',
    ],
    help='Action to perform',
)

parser.add_argument(
    'type',
    choices=[
        'private',
        'sslkeys',
        'phorge_db',
        'phorge_images',
        'sql',
        'mediawiki-xml',
        'swift-account-container',
        'grafana',
        'mattermost-data',
        'mattermost-db',
        'puppetdb',
    ],
    nargs='?',
    help='Type of backup to handle',
)

parser.add_argument(
    '--date',
    dest='date',
    help='Date for backup to download',
    metavar='YYYY-MM-DD',
)

parser.add_argument(
    '--database',
    dest='database',
    help='Specific database to download or backup',
)

args = parser.parse_args()


# ============================================================================
# AWS environment
# ============================================================================

def aws_environment():
    """
    Environment used for all AWS CLI operations.
    """

    env = os.environ.copy()

    env['AWS_CONFIG_FILE'] = AWS_CONFIG_FILE
    env['AWS_SHARED_CREDENTIALS_FILE'] = AWS_CREDENTIALS_FILE
    env['AWS_PROFILE'] = AWS_PROFILE

    env['HTTP_PROXY'] = S3_PROXY
    env['HTTPS_PROXY'] = S3_PROXY

    return env


# ============================================================================
# AWS S3 API command
# ============================================================================

def aws_s3api_command(*arguments):
    """
    Build an aws s3api command.
    """

    command = [
        '/usr/bin/aws',
        's3api',
    ]

    if AWS_PROFILE:
        command.extend([
            '--profile',
            AWS_PROFILE,
        ])

    command.extend(arguments)

    return command


# ============================================================================
# S3 upload
# ============================================================================

def s3_upload(
    local_file: str,
    object_name: str,
):
    print(
        f"Uploading '{local_file}' as "
        f"'{object_name}' using "
        f"{S3_STORAGE_CLASS} storage..."
    )

    command = [
        '/usr/bin/aws',
        's3',
        'cp',
        local_file,
        f"s3://{S3_BUCKET}/{object_name}",
        '--profile',
        AWS_PROFILE,
    ]

    result = subprocess.run(
        command,
        env=aws_environment(),
        preexec_fn=os.setsid,
    )

    if result.returncode == 0:
        return

    print(
        'WARNING: aws s3 cp returned an error. '
        'Checking whether the object was actually uploaded...'
    )

    try:
        metadata = s3_head(object_name)
        local_size = os.path.getsize(local_file)
        remote_size = metadata['ContentLength']

        if remote_size == local_size:
            print(
                f"Upload completed successfully despite "
                f"the AWS CLI error "
                f"({remote_size} bytes uploaded)."
            )
            return

        print(
            f"WARNING: object exists but size differs: "
            f"local={local_size}, remote={remote_size}"
        )

    except subprocess.CalledProcessError:
        pass

    raise subprocess.CalledProcessError(
        result.returncode,
        command,
    )


# ============================================================================
# S3 download
# ============================================================================

def s3_download(
    object_name: str,
    local_file: str = None,
):
    """
    Download an object using the AWS S3 CLI.

    aws s3 cp handles the transfer automatically.
    """

    if local_file is None:
        local_file = os.path.basename(object_name)

    print(
        f"Downloading '{object_name}' "
        f"to '{local_file}'..."
    )

    subprocess.check_call(
        [
            '/usr/bin/aws',
            's3',
            'cp',
            f"s3://{S3_BUCKET}/{object_name}",
            local_file,
            '--profile',
            AWS_PROFILE,
        ],
        env=aws_environment(),
        preexec_fn=os.setsid,
    )


# ============================================================================
# S3 HEAD
# ============================================================================

def s3_head(
    object_name: str,
):
    """
    Retrieve object metadata.
    """

    result = subprocess.check_output(
        aws_s3api_command(
            'head-object',
            '--bucket',
            S3_BUCKET,
            '--key',
            object_name,
            '--output',
            'json',
        ),
        env=aws_environment(),
        text=True,
        preexec_fn=os.setsid,
    )

    return json.loads(result)


# ============================================================================
# S3 list
# ============================================================================

def s3_list(
    prefix: str = "",
):
    """
    List all objects below a prefix.

    list-objects-v2 is paginated, so continue until
    all pages have been retrieved.
    """

    objects = []
    continuation_token = None

    while True:

        command = aws_s3api_command(
            'list-objects-v2',
            '--bucket',
            S3_BUCKET,
            '--output',
            'json',
        )

        if prefix:
            command.extend([
                '--prefix',
                prefix,
            ])

        if continuation_token:
            command.extend([
                '--continuation-token',
                continuation_token,
            ])

        result = subprocess.check_output(
            command,
            env=aws_environment(),
            text=True,
            preexec_fn=os.setsid,
        )

        data = json.loads(result)

        objects.extend(
            item['Key']
            for item in data.get(
                'Contents',
                [],
            )
        )

        if not data.get(
            "IsTruncated",
            False,
        ):
            break

        continuation_token = data.get(
            'NextContinuationToken'
        )

        if not continuation_token:
            break

    return objects


# ============================================================================
# Lifecycle configuration
# ============================================================================

def set_lifecycle():
    print(f"Loading lifecycle policy from '{LIFECYCLE_FILE}'...")

    with open(LIFECYCLE_FILE, "r") as f:
        lifecycle = json.load(f)

    subprocess.check_call(
        aws_s3api_command(
            'put-bucket-lifecycle-configuration',
            '--bucket',
            S3_BUCKET,
            '--lifecycle-configuration',
            f"file://{LIFECYCLE_FILE}",
        ),
        env=aws_environment(),
        preexec_fn=os.setsid,
    )

    print('Lifecycle policy updated successfully.')


def list_lifecycle():
    """
    Display the lifecycle configuration currently
    configured on the bucket.
    """

    print(
        f"Lifecycle configuration for "
        f"bucket '{S3_BUCKET}':"
    )
    print()

    result = subprocess.check_output(
        aws_s3api_command(
            'get-bucket-lifecycle-configuration',
            '--bucket',
            S3_BUCKET,
            '--output',
            'json',
        ),
        env=aws_environment(),
        text=True,
        preexec_fn=os.setsid,
    )

    configuration = json.loads(result)

    print(
        json.dumps(
            configuration,
            indent=2,
        )
    )


# ============================================================================
# Tar helper
# ============================================================================

def create_tar(
    source: str,
    filename: str,
    arcname: str,
):
    """
    Create a gzip-compressed tar archive.
    """

    with tarfile.open(filename, 'w:gz') as tar:
        tar.add(
            source,
            arcname=arcname,
        )


# ============================================================================
# Private
# ============================================================================

def backup_private(dt: str):

    outputFileName = '/srv/backups/private.tar.gz'

    try:
        create_tar(
            '/etc/puppetlabs/puppet/private',
            outputFileName,
            'private',
        )

        s3_upload(
            outputFileName,
            f"private/{dt}.tar.gz",
        )
    finally:
        if os.path.exists(outputFileName):
            os.remove(outputFileName)



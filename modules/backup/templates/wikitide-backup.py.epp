# ============================================================================
# Phorge database
# ============================================================================

def backup_phorge_db(dt: str):

    outputFileName = '/srv/backups/phorge.sql.gz'

    try:
        subprocess.check_call(
            [
                '/srv/phorge/phorge/bin/storage',
                'dump',
                '--compress',
                '--output',
                outputFileName,
            ],
            preexec_fn=os.setsid,
        )

        s3_upload(
            outputFileName,
            f"phorge/{dt}_db.sql.gz",
        )
    finally:
        if os.path.exists(outputFileName):
            os.remove(outputFileName)



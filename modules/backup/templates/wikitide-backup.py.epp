                '/usr/bin/pg_dump mattermost '
                '| /usr/bin/gzip -9 '
                f"> {outputFileName}"
            ),
            shell=True,
            preexec_fn=os.setsid,
        )

        s3_upload(
            outputFileName,
            f"mattermost-db/{dt}.sql.gz",
        )
    finally:
        if os.path.exists(outputFileName):
            os.remove(outputFileName)



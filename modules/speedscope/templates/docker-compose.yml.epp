<%- | String $image,
      String $version,
      Integer $port,
| -%>
services:
  speedscope-service:
    image: "<%= $image %>:<%= $version %>"
    restart: unless-stopped
    ports:
      - "<%= $port %>:3000"
    env_file: .env
    volumes:
      - "./speedscope.db:/data/speedscope.db:rw"
    logging:
      driver: journald
      options:
        tag: "{{.Name}}/{{.ID}}"

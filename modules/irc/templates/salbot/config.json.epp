<%- | String $irc_password, String $phorge_token, Optional[String] $http_proxy | -%>
{
	"irc": {
		"server": "irc.libera.chat",
		"port": 6697,
		"ssl": true,
		"nick": "MirahezeTaskBot",
		"username": "MirahezeTaskBot",
		"password": <%= stdlib::to_json($irc_password) %>,
		"sasl": true,
		"realname": "SAL to Phorge bot",
		"channels": [ "#miraheze-tech-ops" ],
		"ping_interval": 180,
		"reconnect_min": 5,
		"reconnect_max": 300,
		"proxy": "<%= $http_proxy %>"
	},
	"phorge": {
		"url": "https://issue-tracker.miraheze.org",
		"api_token": <%= stdlib::to_json($phorge_token) %>,
		"timeout": 20,
		"proxy": "<%= $http_proxy %>"
	},
	"allowed_senders": [ "*!*@miraheze/bots" ],
	"task_mode": "suffix",
	"skip_patterns": [],
	"sal_url": "https://meta.miraheze.org/wiki/Tech:Server_admin_log",
	"min_post_interval": 1.0,
	"retries": 3,
	"dedupe_seconds": 60,
	"dry_run": false,
	"log_level": "INFO",
	"log_file": "",
	"time_format": "%Y-%m-%d %H:%M UTC",
	"logbot_nick": "MirahezeLogbot",
	"logbot_mask": "MirahezeLogbot!~MirahezeL@miraheze/bots",
	"link_wait": 60
}
